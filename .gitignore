.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/

# Folders to ignore
outputs/*

README_files/*

*.html
.vscode

README_files/

# metadata data folder
artis_metadata_files/data_objects/*

# automatically generated metadata templates - values pulled from artis_data_dictionaries
artis_metadata_files/metadata_templates/attributes_*
artis_metadata_files/metadata_templates/catvars_*

# EML doc itself
artis_metadata_files/eml/*